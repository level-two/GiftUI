# Pinned host/target compatibility contract.
# The official 6.4.0 package reports Swift version 6.4.
GIFTUI_PI_SWIFT_VERSION="6.4"
GIFTUI_PI_SWIFT_TAG="swift-6.4.0-RELEASE"
GIFTUI_PI_HOST_TOOLCHAIN_NAME="${GIFTUI_PI_SWIFT_TAG}-osx"
GIFTUI_PI_HOST_PACKAGE="${GIFTUI_PI_HOST_TOOLCHAIN_NAME}.pkg"
GIFTUI_PI_HOST_PACKAGE_URL="https://download.swift.org/swift-6.4.0-release/xcode/${GIFTUI_PI_SWIFT_TAG}/${GIFTUI_PI_HOST_PACKAGE}"
GIFTUI_PI_HOST_PACKAGE_SHA256="8fd03185b98fe27f54a54631c2449decf75d5b466ce8e34abbd414141063c6aa"
GIFTUI_PI_HOST_PACKAGE_SIGNER="Developer ID Installer: Swift Open Source (V9AUD2URP3)"
GIFTUI_PI_TARGET="armv6-unknown-linux-gnueabihf"
GIFTUI_PI_DISTRIBUTION="raspios-bookworm"
GIFTUI_PI_SDK_NAME="${GIFTUI_PI_SWIFT_TAG}-${GIFTUI_PI_DISTRIBUTION}-armv6"
GIFTUI_PI_SDK_ARCHIVE="${GIFTUI_PI_SDK_NAME}-sdk.tar.gz"
GIFTUI_PI_SDK_URL="https://github.com/swift-embedded-linux/armhf-debian/releases/download/6.4.0/${GIFTUI_PI_SDK_ARCHIVE}"
GIFTUI_PI_SDK_SHA256="3332907e1fe366a24cdd9b4af566cb4f1a1f39aa8fad785cb328af17c7484848"

# Machine-local connection defaults. Override these in local.env or the shell.
: "${GIFTUI_PI_HOST:=giftui-pi.local}"
: "${GIFTUI_PI_USER:=giftui}"
: "${GIFTUI_PI_REMOTE_DIR:=giftui/bin}"
