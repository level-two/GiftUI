# Optional machine-local overrides. Copy this file to local.env; do not commit it.

# Python 3.10 through 3.13 is supported. Python 3.12.13 is the pinned baseline.
# GIFTUI_NRF_PYTHON="/opt/homebrew/bin/python3.12"

# Override host tools only when they satisfy doctor.sh.
# GIFTUI_NRF_CMAKE="/opt/homebrew/bin/cmake"
# GIFTUI_NRF_NINJA="/opt/homebrew/bin/ninja"
# GIFTUI_NRF_DTC="/opt/homebrew/bin/dtc"
# GIFTUI_NRF_JLINK_EXE="/usr/local/bin/JLinkExe"
