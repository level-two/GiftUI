# Pinned nRF52840 development environment. Keep all version changes together.
GIFTUI_NRF_SWIFT_VERSION="6.3.2"
GIFTUI_NRF_SWIFT_TAG="swift-6.3.2-RELEASE"
GIFTUI_NRF_SWIFT_PACKAGE="${GIFTUI_NRF_SWIFT_TAG}-osx.pkg"
GIFTUI_NRF_SWIFT_PACKAGE_URL="https://download.swift.org/swift-6.3.2-release/xcode/${GIFTUI_NRF_SWIFT_TAG}/${GIFTUI_NRF_SWIFT_PACKAGE}"
GIFTUI_NRF_SWIFT_PACKAGE_SHA256="3dd8da736318b6f0a5d7c01b039dd8511f7994cababf9b10534dce1b19ccdca7"
GIFTUI_NRF_SWIFT_PACKAGE_SIGNER="Developer ID Installer: Swift Open Source (V9AUD2URP3)"

GIFTUI_NRF_ZEPHYR_VERSION="4.3.0"
GIFTUI_NRF_ZEPHYR_REVISION="3568e1b6d5cdd51a6b964a2a1d6d29200fea2056"
GIFTUI_NRF_CMSIS_REVISION="512cc7e895e8491696b61f7ba8066b4a182569b8"
GIFTUI_NRF_CMSIS_6_REVISION="30a859f44ef8ab4dc8f84b03ed586fd16ccf9d74"
GIFTUI_NRF_HAL_NORDIC_REVISION="7858281d843468fe53c829995fb63f45a227387a"
GIFTUI_NRF_SEGGER_MODULE_REVISION="9f08435a79d41133d7046b7c59d1b25929eda450"

GIFTUI_NRF_ZEPHYR_SDK_VERSION="0.17.4"
GIFTUI_NRF_SDK_MINIMAL_SHA256_AARCH64="cc3d26aee46b4264e49f5ef85f72aca8622c30d62b6233ef495837d4303d7c2b"
GIFTUI_NRF_SDK_MINIMAL_SHA256_X86_64="c413afc34367262e2fe109a9754340ee966f1f769deed78c2fe1d5475095b666"
GIFTUI_NRF_SDK_ARM_SHA256_AARCH64="c0fbf111d2232dd533d813f49ddfbcc45014c4e2da7f2a17bf80599ac5bfbdeb"
GIFTUI_NRF_SDK_ARM_SHA256_X86_64="25caef36014ee9597d60da3020511f7298f53b08663a0adce33a58d0a9e251bc"

GIFTUI_NRF_BOARD="nrf52840dk/nrf52840"
# Swift names the bundled ARMv7E-M standard module with the eabi spelling.
# Zephyr supplies -mfloat-abi=hard and the Cortex-M4F/FPU flags; build.sh
# verifies the linked ELF's VFP calling convention.
GIFTUI_NRF_SWIFT_TARGET="armv7em-none-none-eabi"
GIFTUI_NRF_FLOAT_ABI="hard"
GIFTUI_NRF_CMAKE_MIN_VERSION="3.29.0"
GIFTUI_NRF_NINJA_MIN_VERSION="1.10.0"
GIFTUI_NRF_DTC_MIN_VERSION="1.6.0"
GIFTUI_NRF_PYTHON_MIN_VERSION="3.10.0"
GIFTUI_NRF_PYTHON_MAX_VERSION="3.14.9"
GIFTUI_NRF_PYTHON_LOCK_VERSION="3.12.13"
GIFTUI_NRF_JLINK_TESTED_VERSION="8.96"
GIFTUI_NRF_RAM_LIMIT_BYTES="196608"
GIFTUI_NRF_FLASH_LIMIT_BYTES="1048576"
GIFTUI_NRF_FLASH_WARNING_BYTES="917504"

: "${GIFTUI_NRF_APPLICATION:=probe}"
