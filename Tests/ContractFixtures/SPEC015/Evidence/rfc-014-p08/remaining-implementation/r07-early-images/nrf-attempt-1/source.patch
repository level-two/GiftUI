diff --git a/firmware/nrf52840/applications/signal-analyzer-static/Counter.cmake b/firmware/nrf52840/applications/signal-analyzer-static/Counter.cmake
new file mode 100644
index 00000000..a02d14ee
--- /dev/null
+++ b/firmware/nrf52840/applications/signal-analyzer-static/Counter.cmake
@@ -0,0 +1,15 @@
+# The supported build boundary verifies every current source/object identity
+# before this finite existing-application image branch is configured.
+include("${GIFTUI_COUNTER_OBJECT_INPUTS}")
+if(NOT giftui_counter_objects)
+    message(FATAL_ERROR "Verified P08 counter objects are required")
+endif()
+set_source_files_properties(${giftui_counter_objects} PROPERTIES
+    EXTERNAL_OBJECT TRUE GENERATED TRUE)
+target_sources(app PRIVATE
+    ${giftui_counter_objects}
+    src/counter_main.c
+    src/spi_tft.c
+    src/fault.c
+    src/stubs.c)
+target_include_directories(app PRIVATE include)
diff --git a/firmware/nrf52840/applications/signal-analyzer-static/src/counter_main.c b/firmware/nrf52840/applications/signal-analyzer-static/src/counter_main.c
new file mode 100644
index 00000000..a55c3e52
--- /dev/null
+++ b/firmware/nrf52840/applications/signal-analyzer-static/src/counter_main.c
@@ -0,0 +1,20 @@
+#include <stdint.h>
+#include <zephyr/kernel.h>
+
+#include "spi_tft.h"
+
+typedef int32_t (*counter_pixel_write)(uint16_t, uint16_t, uint16_t, uint16_t,
+                                      const uint8_t *, size_t);
+extern uint32_t giftui_rfc014_counter_entry(counter_pixel_write write);
+
+int main(void)
+{
+    if (spi_tft_initialize() != 0) {
+        printk("P08 counter display initialization failed\n");
+        return 1;
+    }
+    uint32_t checks = giftui_rfc014_counter_entry(spi_tft_write_rgb565);
+    int shutdown = spi_tft_shutdown();
+    printk("P08 counter assertions=%u shutdown=%d\n", checks, shutdown);
+    return checks > 0 && shutdown == 0 ? 0 : 1;
+}
diff --git a/firmware/nrf52840/applications/signal-analyzer-static/counter-build-checks.conf b/firmware/nrf52840/applications/signal-analyzer-static/counter-build-checks.conf
