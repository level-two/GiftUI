diff --git a/scripts/raspberry-pi/build.sh b/scripts/raspberry-pi/build.sh
index 7ff5717b..fff9a835 100755
--- a/scripts/raspberry-pi/build.sh
+++ b/scripts/raspberry-pi/build.sh
@@ -15,6 +15,7 @@ configuration="release"
 link_static=1
 probe=0
 clean=0
+counter_build=""
 
 usage() {
     cat <<'USAGE'
@@ -27,6 +28,7 @@ Options:
   --dynamic            Do not statically link the Swift standard library.
   --clean              Clean this product's cross-build scratch directory.
   --probe              Build the bundled ARMv6 toolchain probe.
+  --counter-build PATH Link verified P08 counter objects for the existing ARMv6 product.
   -h, --help           Show this help.
 USAGE
 }
@@ -57,6 +59,11 @@ while [[ $# -gt 0 ]]; do
         --probe)
             probe=1
             ;;
+        --counter-build)
+            [[ $# -ge 2 ]] || giftui_pi_error "--counter-build requires a value"
+            counter_build="$2"
+            shift
+            ;;
         -h | --help)
             usage
             exit 0
@@ -95,6 +102,26 @@ host_version="$(giftui_pi_host_swift_version_line)"
 [[ "${host_version}" == *"Swift version ${GIFTUI_PI_SWIFT_VERSION}"* ]] ||
     giftui_pi_error "host Swift ${GIFTUI_PI_SWIFT_VERSION} is required; found: ${host_version}"
 
+if [[ -n "${counter_build}" ]]; then
+    [[ "${product}" == "SignalAnalyzerRaspberryPiARMv6" && "${probe}" -eq 0 &&
+       "${link_static}" -eq 1 && "${configuration}" == "release" && "${clean}" -eq 0 &&
+       "${package_path}" == "${GIFTUI_PI_PROJECT_ROOT}" ]] ||
+        giftui_pi_error "counter inputs require the existing ARMv6 product, release/static defaults"
+    counter_output="${GIFTUI_PI_BUILD_ROOT}/scratch/${product}-rfc014-counter"
+    python3 "${GIFTUI_PI_PROJECT_ROOT}/scripts/contracts/build-spec-015-counter-image.py" \
+        --profile raspberry-pi-armv6 --counter-build "${counter_build}" --output "${counter_output}"
+    file_description="$(giftui_pi_verify_armv6_binary "${counter_output}/counter.elf")"
+    artifact_path="${GIFTUI_PI_ARTIFACTS_DIR}/${product}-rfc014-counter"
+    mkdir -p "${GIFTUI_PI_ARTIFACTS_DIR}"
+    cp -f "${counter_output}/counter.elf" "${artifact_path}"
+    "${GIFTUI_PI_HOST_BIN_DIR}/llvm-objcopy" --strip-all "${artifact_path}"
+    chmod 0755 "${artifact_path}"
+    giftui_pi_note "verified early counter ARMv6 hard-float image: ${file_description}"
+    printf 'ARTIFACT=%s\nELF=%s\nMAP=%s\nREPORTS=%s\n' \
+        "${artifact_path}" "${counter_output}/counter.elf" "${counter_output}/counter.map" "${counter_output}"
+    exit 0
+fi
+
 if [[ "${link_static}" -eq 1 ]]; then
     destination="${GIFTUI_PI_STATIC_DESTINATION}"
     linkage="static"
diff --git a/scripts/contracts/build-spec-015-counter-image.py b/scripts/contracts/build-spec-015-counter-image.py
new file mode 100644
index 00000000..d384c3c4
--- /dev/null
+++ b/scripts/contracts/build-spec-015-counter-image.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Link or hand off the two existing P08 target counter object recipes."""
+import argparse
+import hashlib
+import json
+import pathlib
+import shlex
+import subprocess
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+parser = argparse.ArgumentParser()
+parser.add_argument('--profile', required=True, choices=('raspberry-pi-armv6', 'nrf52840-embedded'))
+parser.add_argument('--counter-build', required=True, type=pathlib.Path)
+parser.add_argument('--output', required=True, type=pathlib.Path)
+args = parser.parse_args()
+base = args.counter_build.resolve()
+output = args.output.resolve()
+target_root = ROOT / ('.build/raspberry-pi' if args.profile == 'raspberry-pi-armv6' else '.build/nrf52840')
+assert base.is_relative_to(target_root) and output.is_relative_to(target_root), 'target output root mismatch'
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+receipt_path = base / 'result.json'
+receipt = json.loads(receipt_path.read_text())
+assert receipt['selected_host_profile'] == args.profile
+assert receipt['raster_realization'] == 'tiled'
+assert all(check['passed'] for check in receipt['checks'])
+for name, expected in receipt['inputs'].items():
+    assert digest(ROOT / name) == expected, 'stale counter input: ' + name
+for name, expected in receipt['artifacts'].items():
+    assert digest(base / name) == expected['sha256'], 'stale counter artifact: ' + name
+compiler = ROOT / receipt['compiler']
+assert digest(compiler) == receipt['compiler_sha256']
+objects = [pathlib.Path(line) for line in (base / 'objects.list').read_text().splitlines()]
+assert objects and len(objects) == len(set(objects))
+for path in objects:
+    assert path.is_relative_to(target_root) and path.suffix == '.o' and path.is_file(), path
+    if path.parent != base:
+        # The sole reused object is the pinned portable declaration module.
+        assert path.name == 'GiftUI.o'
+        core = json.loads((path.parent / 'result.json').read_text())
+        assert digest(path) == core['artifacts']['GiftUI.o']['sha256']
+        assert core['compiler_sha256'] == receipt['compiler_sha256']
+output.mkdir(parents=True, exist_ok=True)
+record = dict(profile=args.profile, counter_build=str(base.relative_to(ROOT)),
+              counter_receipt_sha256=digest(receipt_path), compiler_sha256=digest(compiler),
+              objects={str(path.relative_to(ROOT)): digest(path) for path in objects},
+              execution='not executed; early image link only')
+if args.profile == 'nrf52840-embedded':
+    # Each object remains in its actual owner module; no Swift source flattening.
+    (output / 'counter-objects.cmake').write_text('set(giftui_counter_objects\n' +
+        ''.join('    "' + str(path) + '"\n' for path in objects) + ')\n')
+else:
+    main = output / 'Main.swift'
+    main.write_text('import P08CounterRuntime\n@main struct Main { static func main() { precondition(p08CounterRoute() > 0) } }\n')
+    command = [str(compiler), *receipt['target_flags'], str(main), *map(str, objects),
+               '-static-stdlib', '-Xlinker', '-Map', '-Xlinker', str(output / 'counter.map'),
+               '-o', str(output / 'counter.elf')]
+    record['command'] = shlex.join(command)
+    (output / 'command.txt').write_text(record['command'] + '\n')
+    result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
+    (output / 'link.log').write_text(result.stdout + result.stderr)
+    record['exit_status'] = result.returncode
+    (output / 'input-receipt.json').write_text(json.dumps(record, indent=2) + '\n')
+    if result.returncode:
+        raise SystemExit(result.stdout + result.stderr)
+    record['elf_sha256'] = digest(output / 'counter.elf')
+    record['map_sha256'] = digest(output / 'counter.map')
+(output / 'input-receipt.json').write_text(json.dumps(record, indent=2) + '\n')
+print('COUNTER_INPUTS=' + str(output / 'input-receipt.json'))
