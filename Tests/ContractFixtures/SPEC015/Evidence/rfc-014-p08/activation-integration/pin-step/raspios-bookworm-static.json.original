{
   "version":1,
   "sdk":"/opt/swift-6.4.0-RELEASE-raspios-bookworm-armv6/raspios-bookworm",
   "toolchain-bin-dir":"/usr/bin",
   "target":"armv6-unknown-linux-gnueabihf",
   "dynamic-library-extension":"so",
   "extra-cc-flags":[
      "-march=armv6",
      "-mfpu=vfp",
      "-mfloat-abi=hard",
      "-D_FILE_OFFSET_BITS=64",
      "-fPIC"
   ],
   "extra-swiftc-flags":[
      "-target", "armv6-unknown-linux-gnueabihf",
      "-use-ld=lld",
      "-Xcc", "--gcc-toolchain=/opt/swift-6.4.0-RELEASE-raspios-bookworm-armv6/raspios-bookworm/usr",
      "-Xlinker", "-rpath", "-Xlinker", "/usr/lib/swift_static/linux",
      "-Xlinker", "-rpath", "-Xlinker", "/usr/lib/swift_static/linux/armv6",
      "-resource-dir", "/opt/swift-6.4.0-RELEASE-raspios-bookworm-armv6/raspios-bookworm/usr/lib/swift_static",
      "-sdk", "/opt/swift-6.4.0-RELEASE-raspios-bookworm-armv6/raspios-bookworm",
      "-latomic"
   ],
   "extra-cpp-flags":[
   ]
}
