+// Diagnostic-only: existing type layouts and checked seven-object packing.
+// Appended only to a temporary source copy. No object is initialized or executed.
+#if hasFeature(Embedded)
+@inline(__always)
+fileprivate func p08FixtureDiagnosticAppend<T: ~Copyable>(
+    _ type: T.Type, _ index: Int, _ selected: Int,
+    _ cursor: inout Int, _ maximumAlignment: inout Int, _ selectedOffset: inout Int
+) {
+    let alignment = MemoryLayout<T>.alignment
+    precondition(alignment > 0)
+    let remainder = cursor % alignment
+    let padding = remainder == 0 ? 0 : alignment - remainder
+    let (offset, offsetOverflow) = cursor.addingReportingOverflow(padding)
+    precondition(!offsetOverflow)
+    let (end, endOverflow) = offset.addingReportingOverflow(MemoryLayout<T>.stride)
+    precondition(!endOverflow)
+    if selected == index { selectedOffset = offset }
+    cursor = end
+    maximumAlignment = max(maximumAlignment, alignment)
+}
+@inline(__always)
+fileprivate func p08FixtureDiagnosticPack(_ selected: Int) -> UInt32 {
+    var cursor = 0
+    var maximumAlignment = 1
+    var selectedOffset = 0
+    p08FixtureDiagnosticAppend(P08EmbeddedOuter.self, 0, selected, &cursor, &maximumAlignment, &selectedOffset)
+    p08FixtureDiagnosticAppend(P08TypedBackingOwner.self, 1, selected, &cursor, &maximumAlignment, &selectedOffset)
+    p08FixtureDiagnosticAppend(P08ReuseFingerprint.self, 2, selected, &cursor, &maximumAlignment, &selectedOffset)
+    p08FixtureDiagnosticAppend(InlineArray<14, P08InitializedEntry?>.self, 3, selected, &cursor, &maximumAlignment, &selectedOffset)
+    p08FixtureDiagnosticAppend(P08HostReuseTranscript.self, 4, selected, &cursor, &maximumAlignment, &selectedOffset)
+    p08FixtureDiagnosticAppend(StaticObservableRootAdapter<CounterOwnedModel, SemanticCompleteIdentity>.self, 5, selected, &cursor, &maximumAlignment, &selectedOffset)
+    p08FixtureDiagnosticAppend(CounterControl.self, 6, selected, &cursor, &maximumAlignment, &selectedOffset)
+    let remainder = cursor % maximumAlignment
+    let padding = remainder == 0 ? 0 : maximumAlignment - remainder
+    let (roundedExtent, overflow) = cursor.addingReportingOverflow(padding)
+    precondition(!overflow)
+    let value: Int
+    switch selected {
+    case 0...6: value = selectedOffset
+    case 7: value = cursor
+    case 8: value = maximumAlignment
+    case 9: value = roundedExtent
+    default: preconditionFailure("invalid fixture diagnostic selector")
+    }
+    guard let result = UInt32(exactly: value) else {
+        preconditionFailure("fixture diagnostic exceeds UInt32")
+    }
+    return result
+}
