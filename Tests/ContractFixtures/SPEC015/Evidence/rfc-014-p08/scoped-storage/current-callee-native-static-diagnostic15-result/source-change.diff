+#if os(macOS) && !GIFTUI_COUNTER_ROUTE_DYNAMIC && !hasFeature(Embedded)
+    // Preserve this finite native trace's spelling with bounded fragments instead
+    // of the variadic print call's Any storage.
+    func counterTrace(
+        _ label: StaticString,
+        _ value: (
+            ObservableModelOwnerIdentity, ObservableModelOwnerIdentity,
+            SemanticRecordOwnerIdentity, SemanticRecordOwnerIdentity
+        )
+    ) {
+        counterTraceWrite(label)
+        counterTraceWrite(" (GiftUIObservableState.ObservableModelOwnerIdentity(rawValue: ")
+        counterTraceWrite(value.0.rawValue)
+        counterTraceWrite("), GiftUIObservableState.ObservableModelOwnerIdentity(rawValue: ")
+        counterTraceWrite(value.1.rawValue)
+        counterTraceWrite("), GiftUISemanticCore.SemanticRecordOwnerIdentity(rawValue: ")
+        counterTraceWrite(value.2.rawValue)
+        counterTraceWrite("), GiftUISemanticCore.SemanticRecordOwnerIdentity(rawValue: ")
+        counterTraceWrite(value.3.rawValue)
+        counterTraceWrite("))\n")
+    }
+
+    private func counterTraceWrite(_ text: StaticString) {
+        text.withUTF8Buffer { bytes in
+            for byte in bytes { _ = putchar(Int32(byte)) }
+        }
+    }
+
+    private func counterTraceWrite(_ text: BoundedText) {
+        text.withUTF8 { bytes in
+            for byte in bytes { _ = putchar(Int32(byte)) }
+        }
+    }
+
+    private func counterTraceWrite(_ value: UInt32) {
+        let low = BoundedText(Int32(value % 1_000_000_000))
+        if value >= 1_000_000_000 {
+            counterTraceWrite(BoundedText(Int32(value / 1_000_000_000)))
+            for _ in Int(low.utf8ByteCount) ..< 9 { _ = putchar(48) }
+        }
+        counterTraceWrite(low)
+    }
+#endif
