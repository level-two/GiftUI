+
+@Test func partialMutationFailureRetainsDirtyStateForRederivation() {
+    // A sealed application batch may apply one fact before the next fact fails.
+    // The present result shape can return the error but cannot report that work.
+    var owner = CompletePipelineRecorder()
+    owner.partiallyApplyBeforeFailure = true
+    owner.failureStage = .applyAdmittedWork
+    owner.injectedFailure = .focusedOwner(.observableState(.invalidPhaseContained))
+    let result = RuntimeCompletePipeline.run(owner: &owner)
+    guard case .failed(let record) = result else {
+        Issue.record("expected application failure")
+        return
+    }
+    #expect(owner.appliedFactCount == 1)
+    #expect(record.failure == owner.injectedFailure)
+    #expect(record.disposition.semanticDisposition == .dirty)
+    #expect(record.disposition.wakeReasons.contains(.semanticDirty))
+}
