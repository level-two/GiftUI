#include <zephyr/dt-bindings/display/ili9xxx.h>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

/ {
	aliases {
		giftui-xpt2046 = &giftui_xpt2046;
	};

	chosen {
		zephyr,display = &kmrtm_ili9341;
	};

	kmrtm_mipi_dbi: kmrtm-mipi-dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&arduino_spi>;
		dc-gpios = <&arduino_header ARDUINO_HEADER_R3_D9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&arduino_header ARDUINO_HEADER_R3_D8 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		kmrtm_ili9341: ili9341@0 {
			compatible = "ilitek,ili9341";
			mipi-max-frequency = <4000000>;
			reg = <0>;
			width = <240>;
			height = <320>;
			rotation = <0>;
			pixel-format = <ILI9XXX_PIXEL_FORMAT_RGB565>;
		};
	};
};

&arduino_spi {
	status = "okay";
	cs-gpios = <&arduino_header ARDUINO_HEADER_R3_D10 GPIO_ACTIVE_LOW>,
		     <&arduino_header ARDUINO_HEADER_R3_D7 GPIO_ACTIVE_LOW>;

	giftui_xpt2046: touch@1 {
		compatible = "giftui,xpt2046";
		reg = <1>;
		spi-max-frequency = <2000000>;
		penirq-gpios = <&arduino_header ARDUINO_HEADER_R3_D6 GPIO_ACTIVE_LOW>;
	};
};
